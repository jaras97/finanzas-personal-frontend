# Copy this file to .env.local and fill in real values.

# Base URL of the backend API (finanzas-personales-backend).
NEXT_PUBLIC_API_URL=http://localhost:8000

# JWT verification secret used in Edge middleware (src/middleware.ts) to
# validate the access token before allowing/denying protected routes.
# MUST match the backend's SECRET_KEY exactly, or route protection breaks.
JWT_SECRET=change-me-to-match-backend-SECRET_KEY

# Optional branding overrides (shown in the footer). Safe to omit.
NEXT_PUBLIC_APP_NAME=Balanced Cent
NEXT_PUBLIC_APP_VERSION=v1.0
